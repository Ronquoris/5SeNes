# Copy to backend/.env
PORT=4000
DATABASE_PATH=./dev.db
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# router.project-osrm.org's public demo only serves the driving profile; this FOSSGIS instance
# actually hosts the foot profile we need for pedestrian routing.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=5Sense-AccessibleNav/0.1 (contact: shivanshuaggarwal882@gmail.com)
# Manchester city centre bounding box, used to bias geocoding results (left,top,right,bottom)
MANCHESTER_VIEWBOX=-2.3200,53.5200,-2.1500,53.4300
DEFAULT_LAT=53.4808
DEFAULT_LON=-2.2426
